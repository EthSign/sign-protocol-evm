{
  "name": "@ethsign/sign-protocol-evm",
  "version": "1.1.4",
  "packageManager": "bun@1.3.13",
  "description": "Sign Protocol is an omni-chain attestation protocol, enabling users to freely attest and verify any information on-chain.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EthSign/sign-protocol-evm"
  },
  "scripts": {
    "clean": "forge clean",
    "build": "forge build",
    "deploy:sp-impl": "forge script script/DeploySPImplementation.s.sol --broadcast",
    "deploy:sp-proxy": "forge script script/DeploySPProxy.s.sol --broadcast",
    "fmt": "forge fmt",
    "fmt:check": "forge fmt --check",
    "patch:sp": "bash script/patch-sp-deployment.sh",
    "upgrade:sp-proxies": "forge script script/UpgradeSPProxies.s.sol --broadcast",
    "test": "forge test",
    "test:coverage": "forge coverage"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@openzeppelin/contracts": "5.0.1",
    "@openzeppelin/contracts-upgradeable": "5.0.1"
  }
}
